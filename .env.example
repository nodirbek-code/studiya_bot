# ─── Telegram ───────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
WEBHOOK_SECRET=your_random_secret_32chars
WEBHOOK_HOST=https://yourdomain.com
ADMIN_IDS=123456789,987654321          # vergul bilan ajratilib

# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=studio_booking
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://studio_user:strong_password_here@postgres:5432/studio_booking

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Payment ─────────────────────────────────────────────────
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_TEST_MODE=true

CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

# ─── App ─────────────────────────────────────────────────────
APP_SECRET_KEY=super_secret_jwt_key_here
DEBUG=false
ENVIRONMENT=production

# ─── Payment config ──────────────────────────────────────────
DEPOSIT_PERCENT=30          # oldindan to'lov foizi
BOOKING_TIMEOUT_MINUTES=10  # to'lov kutish vaqti
